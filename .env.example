# Порт локального прокси-сервера
PORT=3000

# URL сервисов RelationFlow
RELATIONFLOW_URL=https://app.relationflow.io
SUPABASE_URL=https://auth.relationflow.io
SUPABASE_ANON_KEY=sb_publishable_tHnRZvqCh23wsocWynthJg_5bQVoFsA

# Slug вашего аккаунта (берется из адресной строки: /dashboard/<accountSlug>/chat)
ACCOUNT_SLUG=your_account_slug_here

# Начальный refresh_token из сессии RelationFlow
INITIAL_REFRESH_TOKEN=your_refresh_token_here

# Модель по умолчанию
DEFAULT_MODEL=managed:claude-opus-5.5

# Маппинг клиентских моделей
MODEL_MAP={"gpt-6-astra":"managed:claude-opus-5.5","astra":"managed:claude-opus-5.5","opus":"managed:claude-opus-5.5","opus-5.5":"managed:claude-opus-5.5","claude-opus-5.5":"managed:claude-opus-5.5"}
