PORT=3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
RELATIONFLOW_URL=https://api.relationflow.internal

# Начальные токены авторизации (будут обновляться и ротироваться автоматически)
INITIAL_ACCESS_TOKEN=
INITIAL_REFRESH_TOKEN=
INITIAL_SESSION_COOKIE=

# Модель по умолчанию в RelationFlow (будет использоваться при запросах с gpt-6-astra и неизвестными моделями)
DEFAULT_MODEL=gpt-4o

# Кастомный маппинг моделей (JSON-словарь соответствий клиентских моделей моделям в RelationFlow)
MODEL_MAP={"gpt-6-astra":"gpt-4o","astra":"gpt-4o"}
